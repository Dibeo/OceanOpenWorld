// Editable material interface for the volumetric cloud shaders.
// CloudBase/CloudThickness/TileMeters are world-space distances; Coverage is a fraction,
// Density is extinction per world unit, and Steps/LightSteps trade quality for GPU cost.
// Keep these parameter names synchronized with CloudManager and Shaders/Clouds.
MaterialDef Clouds {

    MaterialParameters {
        // R shape, G weather, B/A detail (see CloudNoiseGenerator)
        Texture2D NoiseMap

        // Lighting (the direction points TOWARD the sun)
        Vector3 SunDirection
        Vector3 SunColor
        Vector3 AmbientColor
        Vector3 HorizonColor

        // Wind: current offset and cloud shear with altitude, in meters
        Vector2 WindOffset
        Vector2 Shear

        // Cloud-layer geometry, in meters
        Float CloudBase
        Float CloudThickness
        Float TileMeters
        Float MaxDistance

        // Aspect
        Float Coverage
        Float Density
        Float Erosion

        // Quality
        Int Steps
        Int LightSteps
    }

    Technique {
        VertexShader GLSL150:   Shaders/Clouds/Clouds.vert
        FragmentShader GLSL150: Shaders/Clouds/Clouds.frag

        WorldParameters {
            WorldMatrix
            WorldViewProjectionMatrix
            CameraPosition
        }

        // The Sky bucket is drawn at depth 1; terrain at depth < 1 occludes the clouds.
        // Premultiplied output: RGB is already multiplied by alpha.
        RenderState {
            Blend PremultAlpha
            DepthTest On
            DepthWrite Off
            FaceCull Off
        }
    }
}

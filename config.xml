<?xml version="1.0" encoding="UTF-8"?>
<gameConfig>

    <!--
      The required document root is <gameConfig>. Runtime settings are loaded by
      GameConfig.load("config.xml"). All ten section elements and
      every listed attribute are required; this file format has no attribute defaults. Exactly
      one element with each required section name must occur in the document (the loader searches
      descendants, not just direct children). Numeric
      values must parse as the indicated Java number type. Float settings checked as finite by
      the loader must not be NaN or infinite. Boolean values are exactly "true" or "false".
      Additional XML elements and attributes are not a substitute for these required settings.

      world:
        seed                  Required signed 64-bit integer; seeds procedural world content.
      terrain:
        chunkSize             Required positive integer; world-space chunk width/depth.
        subdivisions          Required integer in [1, 256]; samples per chunk edge.
                              Must divide chunkSize evenly.
        renderDistance        Required integer in [0, 64]; chunk radius around the camera.
        maxChunksPerFrame     Required positive integer; chunk build budget per frame.
      camera:
        speed                 Required finite positive movement speed (world units per second).
        farPlane              Required finite distance greater than 1 world unit.
      graphics:
        width, height         Required positive integer window dimensions in pixels.
        vsync                 Required boolean.
        gammaCorrection       Required boolean.
        fpsLimit              Required positive integer frame-rate limit.
      water:
        height                Required water-plane Y coordinate in world units. Parsed as float;
                              unlike the other checked water floats, no range/finiteness rule is
                              applied by GameConfig.
        transparency          Required finite nonnegative water transparency.
        waveSpeed             Required finite nonnegative animation speed.
        waveScale             Required finite nonnegative wave scale.
        maxAmplitude          Required finite nonnegative wave amplitude in world units.
        windChangeSpeed       Required finite positive wind-variation rate.
        windStrengthVariation Required finite fraction in [0, 1].
        reflectionMapSize     Required positive integer reflection-map dimension in pixels.
      lighting:
        sunIntensity          Required finite nonnegative sun multiplier.
      grass:
        density               Required finite value in (0, 16] clumps per square metre.
        distance              Required finite visibility radius in [10, 400] world units.
        flowers               Required finite fraction in [0, 1]; 0 disables flower placement.
      rocks:
        density               Required finite density in [0, 50] main rocks per 1000 square metres.
        sizeScale             Required finite size multiplier in [0.2, 4].
      trees:
        density               Required finite placement fraction in [0, 1] applied to 8 m candidates
                              on grassy terrain; 0 disables tree placement.
        detailDistance        Required finite high-detail radius in [30, 400] world units.
      clouds:
        enabled               Required boolean.
        altitude              Required finite positive cloud-base altitude in world units.
        thickness             Required finite positive cloud-layer thickness in world units.
        coverage              Required finite fraction in [0, 1].
        density               Required finite positive extinction coefficient (per world unit).
        windSpeed             Required finite nonnegative speed in world units per second.
        tileMeters            Required finite positive world-space noise-texture tile size.
        textureSize           Required integer: 256, 512, or 1024 pixels.
        steps                 Required integer ray-march sample count in [8, 128].
        lightSteps            Required integer light-ray sample count in [1, 8].
    -->
    <world seed="1" />

    <terrain
        chunkSize="64"
        subdivisions="32"
        renderDistance="8"
        maxChunksPerFrame="8"
    />

    <camera
        speed="35.0"
        farPlane="1200.0"
    />

    <graphics
        width="1280"
        height="720"
        vsync="true"
        gammaCorrection="true"
        fpsLimit="60"
    />

    <water
        height="0.0"
        transparency="0.05"
        waveSpeed="0.6"
        waveScale="0.004"
        maxAmplitude="0.8"
        windChangeSpeed="0.015"
        windStrengthVariation="0.5"
        reflectionMapSize="512"
    />

    <lighting
        sunIntensity="1.5"
    />

    <grass
        density="2.5"
        distance="110.0"
        flowers="0.5"
    />

    <rocks
        density="4.0"
        sizeScale="1.0"
    />

    <trees
        density="0.15"
        detailDistance="180.0"
    />

    <clouds
        enabled="true"
        altitude="700.0"
        thickness="420.0"
        coverage="0.65"
        density="0.04"
        windSpeed="6.0"
        tileMeters="6000.0"
        textureSize="256"
        steps="48"
        lightSteps="5"
    />

</gameConfig>
MaterialDef Grass {
    // Grass atlas and optional flower mask share UV layout. Fade distances are horizontal metres;
    // WindDirection is an XZ-plane vector, WindStrength is normalized, and Time is elapsed seconds.
    // Keep shader parameter names synchronized with TerrainManager and Shaders/Grass.
    MaterialParameters {
        Texture2D ColorMap
        // Flower heads (R petals, G centers), aligned with ColorMap
        Texture2D FlowerMap
        Vector2 WindDirection
        Float WindStrength
        Float Time
        Vector3 SunDirection
        Color SunColor
        Color AmbientColor
        // World-space distances in meters over which grass clumps shrink to zero
        Float FadeStart
        Float FadeEnd
    }

    Technique {
        VertexShader GLSL150:   Shaders/Grass/Grass.vert
        FragmentShader GLSL150: Shaders/Grass/Grass.frag

        WorldParameters {
            WorldMatrix
            WorldViewProjectionMatrix
            CameraPosition
        }

        RenderState {
            FaceCull Off
        }
    }
}

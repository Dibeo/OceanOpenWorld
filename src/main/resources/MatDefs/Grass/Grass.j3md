MaterialDef Grass {
    MaterialParameters {
        Texture2D ColorMap
        // Têtes de fleurs (R pétales, G cœur), même disposition que ColorMap
        Texture2D FlowerMap
        Vector2 WindDirection
        Float WindStrength
        Float Time
        Vector3 SunDirection
        Color SunColor
        Color AmbientColor
        // Distances (mètres) entre lesquelles les touffes rétrécissent jusqu'à disparaître
        Float FadeStart
        Float FadeEnd
    }

    Technique {
        VertexShader GLSL150:   Shaders/Grass/Grass.vert
        FragmentShader GLSL150: Shaders/Grass/Grass.frag

        WorldParameters {
            WorldMatrix
            WorldViewProjectionMatrix
            CameraPosition
        }

        RenderState {
            FaceCull Off
        }
    }
}

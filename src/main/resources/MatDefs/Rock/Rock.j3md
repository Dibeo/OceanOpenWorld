MaterialDef Rock {
    // NoiseMap channels encode broad tone, fine grain, and cracks; the shader samples it
    // triplanarly in world space. TextureScale is metres per repeat; BumpStrength scales relief.
    // Keep parameter names synchronized with TerrainManager and Shaders/Rock.
    MaterialParameters {
        // R broad tone, G grain, B cracks (see RockTexture); sampled triplanarly
        Texture2D NoiseMap
        Vector3 SunDirection
        Color SunColor
        Color AmbientColor
        Float TextureScale
        Float BumpStrength
    }

    Technique {
        VertexShader GLSL150:   Shaders/Rock/Rock.vert
        FragmentShader GLSL150: Shaders/Rock/Rock.frag

        WorldParameters {
            WorldMatrix
            WorldViewProjectionMatrix
            CameraPosition
        }

        RenderState {
            FaceCull Back
        }
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Editable procedural surface-texture catalog. Loaded from the classpath as /textures.xml.
  Values without stated units are dimensionless. The loader requires a <textures> root and
  reads each direct child <texture>; texture names must be unique.

  <texture name="..." size="..." tileMeters="...">:
    name       Required lookup key used by terrain/material code.
    size       Optional square image width/height in pixels; default 256. Must be a power of
               two from 16 through 1024.
    tileMeters Optional world-space width/height covered by one repetition; default 4; must
               be greater than zero.
    Provide at least one <diffuse> or <normal>; each supplied map needs one or more <layer>.
    If a map is repeated, only its first occurrence is read.

  <diffuse base="..." contrast="..." r="..." g="..." b="...">:
    base       Default 0.9; constant component of the generated diffuse multiplier.
    contrast   Default 1; multiplier applied to the sum of layer values.
    r/g/b      Default 1 each; per-channel multipliers.
    Generated channel = clamp((base + contrast * summedLayers) * channelMultiplier, 0, 1).
  <normal strength="...">:
    strength   Default 6; dimensionless scale for height differences when deriving normals.
    The other map attributes (base, contrast and r/g/b) default as above but do not affect
    normal-map generation.

  <layer type="perlin|ripple|grain" ...>:
    type       Required; case-insensitive PERLIN, RIPPLE, or GRAIN.
    amplitude  Optional finite layer contribution; default 1. No range restriction is imposed.
    PERLIN: cells (default 8, must be >= 1), octaves (default 1, range 1..8),
            persistence (default 0.5), and amplitude. The loader requires
            cells * 2^(octaves - 1) <= 256. Persistence and amplitude have no range check.
    RIPPLE: frequency (default 4, must be >= 1), warpCells (default 4, range 1..256),
            warpAmount (default 0), and amplitude. warpAmount has no range check.
    GRAIN: amplitude controls the contribution of per-pixel random grain.
    Non-finite recognized numeric attributes are rejected. Numeric attributes not relevant to a layer
    type are parsed using their defaults and otherwise ignored by that layer.

  The catalog is deterministic from the world seed and texture name. Perlin and ripple terms
  are periodic; grain is generated independently per pixel and is not explicitly edge-wrapped,
  so inspect seams after adding grain. Run the texture-definition tests after edits.
-->
<textures>
    <texture name="sand" size="256" tileMeters="4">
        <diffuse base="0.92" contrast="1.0" r="1" g="0.82" b="0.55">
            <layer type="perlin" cells="32" octaves="1" amplitude="0.04"/>
            <layer type="perlin" cells="96" octaves="1" amplitude="0.04"/>
            <layer type="grain" amplitude="0.05"/>
        </diffuse>
        <normal strength="6">
            <layer type="ripple" frequency="6" warpCells="4" warpAmount="0.35" amplitude="0.35"/>
            <layer type="perlin" cells="64" octaves="2" persistence="0.5" amplitude="0.49"/>
        </normal>
    </texture>
    <texture name="grass" size="256" tileMeters="4">
        <diffuse base="0.88" contrast="0.7" r="0.23" g="0.37" b="0.15">
            <layer type="perlin" cells="4" octaves="2" persistence="0.5" amplitude="0.10"/>
            <layer type="perlin" cells="24" octaves="2" persistence="0.55" amplitude="0.05"/>
            <layer type="grain" amplitude="0.02"/>
        </diffuse>
        <normal strength="5">
            <layer type="perlin" cells="48" octaves="3" persistence="0.5" amplitude="0.32"/>
            <layer type="grain" amplitude="0.12"/>
        </normal>
    </texture>
    <texture name="gravel" size="256" tileMeters="4">
        <diffuse base="0.82" contrast="0.8" r="0.78" g="0.82" b="0.86">
            <layer type="perlin" cells="40" octaves="2" persistence="0.5" amplitude="0.07"/>
            <layer type="grain" amplitude="0.08"/>
        </diffuse>
        <normal strength="7">
            <layer type="perlin" cells="64" octaves="3" persistence="0.52" amplitude="0.48"/>
            <layer type="grain" amplitude="0.18"/>
        </normal>
    </texture>
    <!-- Green variants blended with the base grass color using noise (see TerrainChunk / TerrainGenerator). -->
    <texture name="grass_dry" size="256" tileMeters="4">
        <diffuse base="0.88" contrast="0.7" r="0.80" g="0.88" b="0.16">
            <layer type="perlin" cells="24" octaves="2" persistence="0.55" amplitude="0.07"/>
            <layer type="grain" amplitude="0.035"/>
        </diffuse>
        <normal strength="5">
            <layer type="perlin" cells="48" octaves="3" persistence="0.5" amplitude="0.32"/>
            <layer type="grain" amplitude="0.12"/>
        </normal>
    </texture>
    <texture name="grass_deep" size="256" tileMeters="4">
        <diffuse base="0.68" contrast="0.7" r="0.12" g="0.62" b="0.24">
            <layer type="perlin" cells="24" octaves="2" persistence="0.55" amplitude="0.07"/>
            <layer type="grain" amplitude="0.035"/>
        </diffuse>
        <normal strength="5">
            <layer type="perlin" cells="48" octaves="3" persistence="0.5" amplitude="0.32"/>
            <layer type="grain" amplitude="0.12"/>
        </normal>
    </texture>
</textures>